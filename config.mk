CONFIG_DIR := $(dir $(lastword $(MAKEFILE_LIST)))
REPO_ROOT ?= .

BOARD ?= nucleo-l152re
BOARD_CONFIG := $(CONFIG_DIR)boards/$(BOARD).mk

ifeq ($(wildcard $(BOARD_CONFIG)),)
$(error Unknown BOARD '$(BOARD)'; expected a file at $(BOARD_CONFIG))
endif

include $(BOARD_CONFIG)

APP_VERSION := 1
WATCHDOG_TIMEOUT_MS := 4000

BOOTLOADER_FLASH_ADDR := 0x08000000
BOOTLOADER_FLASH_SIZE := 0x00010000
BOOT_STATE_FLASH_ADDR := 0x08010000
BOOT_STATE_FLASH_SIZE := 0x00001000
APP_SLOT_SIZE := 0x00037000
APP_SLOT_A_FLASH_ADDR := 0x08011000
APP_SLOT_B_FLASH_ADDR := 0x08048000
